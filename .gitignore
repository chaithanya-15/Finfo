# virtualenv
.venv/

# large source corpus, regenerate with: python -m src.data_processing.download_pdfs
data/raw_pdfs/
data/processed_chunks/
data/extracted_text/

# vector indexes, rebuilt from chunks
indexes/
*_chroma_db/

# Experiment outputs are tracked. About 3 MB, and they are the evidence behind every number
# in the report: the per-question dumps the error analysis cites, and the probe outputs
# behind the retrieval-metric validation. Throwaway smoke and verification runs stay out,
# as do raw run logs, since neither backs anything the report claims.
results/test_baseline_run/
results/experiments_restore*
results/experiments_tablefix*
results/experiments/comparison_backup.csv
*.log

# python
__pycache__/
*.py[cod]
*.egg-info/


